# Server Configuration
SERVER_ADDRESS=:8080

# SQLite Database
# Path to the SQLite database file (auto-created if not exists)
SQLITE_PATH=data/streetview.db

# API Keys
# OpenRouter API key for AI services (https://openrouter.ai)
AI_API_KEY=your_openrouter_api_key_here

# Optional OpenRouter model override.
# OPENROUTER_MODEL and AI_MODEL are equivalent; CN_AI_MODEL is used only when no
# AI/shared proxy is configured.
# OPENROUTER_MODEL=openai/gpt-5.4-mini
# AI_MODEL=openai/gpt-5.4-mini
# CN_AI_MODEL=minimax/minimax-m2.7
# Provider endpoints are sorted by latency by default. Use throughput/price, or
# set off to restore OpenRouter's default provider ordering.
# OPENROUTER_PROVIDER_SORT=latency

# Google Maps API key for backend geocoding and location services
GOOGLE_API_KEY=your_google_maps_api_key_here

# Google Maps Map ID (optional, mainly used by frontend)
GOOGLE_MAPS_MAP_ID=your_google_maps_map_id_here

# Sentry Configuration (Error Tracking and Performance Monitoring)
SENTRY_DSN=your_sentry_dsn_here
GO_ENV=development
SENTRY_RELEASE=1.0.0
SENTRY_SAMPLE_RATE=1.0
SENTRY_ENABLED=true
SENTRY_TEST_ENDPOINT_ENABLED=false

# Feature Flags
ENABLE_AI=true
ENABLE_GOOGLE_API=true
MAP_DATA_AUTO_UPDATE=false

# Security Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
CORS_ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
CORS_MAX_AGE=86400

# Logging Configuration (optional)
LOG_LEVEL=INFO

# Proxy Configuration (optional)
# PROXY_URL=http://your-proxy-server:port
# PROXY_TYPE=http
# PROXY_USER=username
# PROXY_PASS=password
# AI_PROXY_URL=http://your-ai-specific-proxy:port
# MAPS_PROXY_URL=http://your-maps-specific-proxy:port

# Atlas Voice / OpenAI Realtime (optional)
# OPENAI_API_KEY=your_openai_api_key_here
# REALTIME_API_KEY=your_openai_realtime_key_here
# OPENAI_REALTIME_MODEL=gpt-realtime-2
# OPENAI_REALTIME_API_BASE=https://api.openai.com/v1
# OPENAI_REALTIME_WS_URL=
# OPENAI_REALTIME_VOICE=cedar
# OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# OPENAI_REALTIME_VAD_TYPE=semantic_vad
# OPENAI_REALTIME_VAD_EAGERNESS=high
# OPENAI_REALTIME_VAD_THRESHOLD=0.5
# OPENAI_REALTIME_VAD_PREFIX_PADDING_MS=250
# OPENAI_REALTIME_VAD_SILENCE_DURATION_MS=350
# OPENAI_REALTIME_ALLOWED_ORIGINS=https://earth.wangyufeng.org

# Atlas Voice output provider (optional: openai or doubao)
# ATLAS_VOICE_PROVIDER=openai

# Doubao / Volcengine TTS output (optional, used when ATLAS_VOICE_PROVIDER=doubao)
# DOUBAO_TTS_API_KEY=your_doubao_tts_api_key_here
# DOUBAO_TTS_APP_ID=your_doubao_tts_app_id_here
# DOUBAO_TTS_ACCESS_KEY=your_doubao_tts_access_key_or_token_here
# DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
# DOUBAO_TTS_SPEAKER=zh_male_m191_uranus_bigtts
# DOUBAO_TTS_FORMAT=pcm
# DOUBAO_TTS_SAMPLE_RATE=24000
# DOUBAO_TTS_SPEECH_RATE=0
# DOUBAO_TTS_PROXY_URL=http://your-tts-specific-proxy:port
