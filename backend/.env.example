# Server Configuration
SERVER_ADDRESS=:8080

# SQLite Database
# Path to the SQLite database file (auto-created if not exists)
SQLITE_PATH=data/streetview.db

# API Keys
# OpenRouter API key for AI services (https://openrouter.ai)
AI_API_KEY=your_openrouter_api_key_here

# Optional OpenRouter model override. Atlas descriptions, interest regions and
# Geo Guess satellite-image guessing share one model.
# OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# Geo Guess vision providers are sorted by latency by default. Use
# throughput/price, or set off to restore OpenRouter's default ordering.
# OPENROUTER_PROVIDER_SORT=latency
# Atlas descriptions use Exa fast search with the existing evidence budget.
# Set auto to restore the previous native/Exa automatic search routing.
# OPENROUTER_DESCRIPTION_SEARCH=fast
# Independent from Geo Guess; omitted uses automatic routing for V4.1 Flash.
# The legacy V4 Flash Vision Exp override retains its measured Fireworks preference.
# OPENROUTER_DESCRIPTION_PROVIDER_SORT=off

# Google Maps API key for backend geocoding and location services
GOOGLE_API_KEY=your_google_maps_api_key_here

# Sentry Configuration (Error Tracking and Performance Monitoring)
SENTRY_DSN=your_sentry_dsn_here
GO_ENV=development
SENTRY_RELEASE=1.0.0
SENTRY_SAMPLE_RATE=1.0
SENTRY_ENABLED=true
SENTRY_TEST_ENDPOINT_ENABLED=false

# Feature Flags
ENABLE_AI=true
ENABLE_GOOGLE_API=true
MAP_DATA_AUTO_UPDATE=false

# Security Configuration
# Per-endpoint limits are defined in code; this only switches them on or off.
RATE_LIMIT_ENABLED=true

# Proxy Configuration (optional)
# PROXY_URL=http://your-proxy-server:port
# PROXY_TYPE=http
# PROXY_USER=username
# PROXY_PASS=password
# AI_PROXY_URL=http://your-ai-specific-proxy:port
# MAPS_PROXY_URL=http://your-maps-specific-proxy:port

# Atlas Voice / OpenAI Realtime (optional)
# OPENAI_API_KEY=your_openai_api_key_here
# REALTIME_API_KEY=your_openai_realtime_key_here
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
# OPENAI_REALTIME_API_BASE=https://api.openai.com/v1
# OPENAI_REALTIME_WS_URL=
# OPENAI_REALTIME_VOICE=cedar
# OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# OPENAI_REALTIME_VAD_TYPE=semantic_vad
# OPENAI_REALTIME_VAD_EAGERNESS=high
# OPENAI_REALTIME_VAD_THRESHOLD=0.5
# OPENAI_REALTIME_VAD_PREFIX_PADDING_MS=250
# OPENAI_REALTIME_VAD_SILENCE_DURATION_MS=350
# OPENAI_REALTIME_ALLOWED_ORIGINS=https://earth.wangyufeng.org
# Legacy WebRTC path (/realtime/client-secret, /realtime/calls). Off by default:
# ephemeral secrets bypass the WebSocket relay's connection limits and event filter.
# Only enable together with VITE_REALTIME_TRANSPORT=webrtc.
# REALTIME_WEBRTC_ENABLED=false

# Atlas Voice output provider (optional: openai or doubao). Production uses doubao.
# ATLAS_VOICE_PROVIDER=openai

# Doubao / Volcengine TTS output (optional, used when ATLAS_VOICE_PROVIDER=doubao)
# DOUBAO_TTS_API_KEY=your_doubao_tts_api_key_here
# DOUBAO_TTS_APP_ID=your_doubao_tts_app_id_here
# DOUBAO_TTS_ACCESS_KEY=your_doubao_tts_access_key_or_token_here
# DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
# DOUBAO_TTS_SPEAKER=zh_male_m191_uranus_bigtts
# DOUBAO_TTS_FORMAT=pcm
# DOUBAO_TTS_SAMPLE_RATE=24000
# DOUBAO_TTS_SPEECH_RATE=0
# DOUBAO_TTS_PROXY_URL=http://your-tts-specific-proxy:port

# Exact trusted reverse proxy hop CIDRs, empty = no trusted forwarding headers.
# SG currently uses the Compose network 172.18.0.0/16; verify before configuring.
TRUSTED_PROXY_CIDRS=
